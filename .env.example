# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/egx_ai

# Application
APP_NAME=EGX AI
APP_VERSION=0.1.0
DEBUG=false

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# AI Provider (ollama or openai)
AI_PROVIDER=ollama
AI_MODEL=llama3

# OpenAI (if using openai provider)
OPENAI_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=egx_ai
