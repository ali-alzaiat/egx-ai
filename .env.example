# Database (keep credentials in sync with the PostgreSQL block below)
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/egx_ai

# Connection pool (the app reuses connections; tests always use NullPool)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Application
APP_NAME=EGX AI
APP_VERSION=0.1.0
DEBUG=false

# Auth: shared bearer token (32+ chars) for every API route except /api/health.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The Vite dev proxy reads the same variable and attaches it to /api requests.
API_TOKEN=

# Expose /docs, /redoc and /openapi.json (off by default)
API_DOCS_ENABLED=false

# Market refresh job timeout
SYNC_JOB_TIMEOUT_SECONDS=1800

# Camelot PDF engine (runs Ghostscript on uploaded PDFs; keep off for untrusted files)
CAMELOT_ENABLED=false

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# AI Provider (ollama or openai)
AI_PROVIDER=ollama
AI_MODEL=llama3

# R49 AI assistant (Admin > AI settings). Keys saved in the UI are stored encrypted with
# AI_SECRETS_KEY; leave it unset and UI key saving is refused (503), env keys still work.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing AI_SECRETS_KEY makes saved keys unreadable: re-enter them in the UI.
AI_SECRETS_KEY=
# Fallback provider keys, used when no key is saved in the UI (a UI-saved key wins)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=egx_ai
